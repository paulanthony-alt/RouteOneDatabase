rules_version = '2';

// Only signed-in staff can touch the ledger: the shared site login below, or
// anyone with a document in /staff whose id is their email in lower case.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    // The shared site login, plus anyone listed in /staff.
    function isStaff() {
      return signedIn() && (
        email() == 'paulanthony@cappiali.com' ||
        exists(/databases/$(database)/documents/staff/$(email()))
      );
    }

    // Each person may check their own staff entry; nobody can edit the list from the app.
    match /staff/{id} {
      allow read: if signedIn() && id == email();
      allow write: if false;
    }

    // Shared ledger state (shows, bankroll, settings, ID counters).
    match /ledger/{doc} {
      allow read, write: if isStaff();
    }

    // One document per inventory record.
    match /cards/{id} {
      allow read, write: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
